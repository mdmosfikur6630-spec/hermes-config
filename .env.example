# Copy to ~/.hermes/.env and fill in. Never commit the filled file.
#
# LLM provider (example: DeepSeek)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Telegram gateway
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to the bot.
TELEGRAM_ALLOWED_USERS=

# Steer immediately instead of queueing follow-ups sent within 3s of task start.
HERMES_TELEGRAM_FOLLOWUP_GRACE_SECONDS=0
